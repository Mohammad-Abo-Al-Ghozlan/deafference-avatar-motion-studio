+import { Quaternion, Vector3, type Object3D } from 'three'
+import type { SolvedPose } from './types'
+
+interface BoundRotation {
+  node: Object3D
+  rest: Quaternion
+  current: Quaternion
+  target: Quaternion
+}
+
+interface BoundTranslation {
+  node: Object3D
+  rest: Vector3
+  current: Vector3
+  target: Vector3
