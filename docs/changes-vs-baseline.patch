+          arg = i
+        }
+      }
+      next[j] = best + costs[k][j]
+      pointer[j] = arg
+    }
+    total = next
+    back.push(pointer)
+  }
+  const path = new Int32Array(n)
+  let arg = 0
+  for (let j = 1; j < m; j += 1) if (total[j] < total[arg]) arg = j
+  path[n - 1] = arg
+  for (let k = n - 1; k > 0; k -= 1) path[k - 1] = back[k][path[k]]
+  return path
+}
+
+main().catch((error) => {
+  console.error(error)
+  process.exit(1)
+})
