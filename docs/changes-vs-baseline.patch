+        height=int(stream["height"]),
+        codec=str(stream.get("codec_name")),
+        pix_fmt=str(stream.get("pix_fmt")),
+        time_base=str(stream["time_base"]),
+        r_frame_rate=str(stream.get("r_frame_rate")),
